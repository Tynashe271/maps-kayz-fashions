# Optional override. The deployed admin portal is used when this is unset.
EXPO_PUBLIC_ADMIN_URL=https://maps-kayz-admin.pages.dev/

# HTTP Basic Auth in front of the admin portal (frontend-admin/functions/_middleware.js).
# Without these the WebView just shows the "Authentication required." 401 body.
# See SECRETS.local.md for the real values.
EXPO_PUBLIC_ADMIN_BASIC_AUTH_USER=
EXPO_PUBLIC_ADMIN_BASIC_AUTH_PASS=
