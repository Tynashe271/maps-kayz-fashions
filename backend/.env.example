NODE_ENV=development
PORT=9200
# Local development uses SQLite when DATABASE_URL is omitted.
DATABASE_PATH=maps-kayz.sqlite
# Production example:
# DATABASE_URL=postgres://maps_kayz:change-me@localhost:5432/maps_kayz
# Set to "true" for a managed/serverless Postgres that terminates TLS with a
# publicly-trusted cert (Neon, Supabase, etc — anything needing "?sslmode=require").
# DATABASE_SSL=true
JWT_SECRET=replace-with-a-long-random-production-secret
# International digits only, for example 263771234567.
WHATSAPP_ORDER_NUMBER=
# Comma-separated allowed origins for the deployed frontend(s), e.g.
# https://mapskayz.com,https://admin.mapskayz.com. Leave unset in local
# development (falls back to allowing any origin).
CORS_ORIGINS=
# Optional shared secrets checked against the `x-webhook-secret` header on
# POST /api/webhooks/payment and /api/webhooks/whatsapp. Leave unset in local
# development; set both once a real payment provider / WhatsApp Business
# Platform webhook is configured against this backend.
PAYMENT_WEBHOOK_SECRET=
WHATSAPP_WEBHOOK_SECRET=
# WhatsApp Business Cloud API — real, server-sent messages (receipts,
# low-stock alerts). From a Meta developer app's WhatsApp product dashboard.
# Leave unset in local development; every WhatsApp-sending feature degrades
# to a no-op (logged, not thrown) without them.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Where low-stock alerts are sent; falls back to WHATSAPP_ORDER_NUMBER if unset.
WHATSAPP_ALERT_NUMBER=
