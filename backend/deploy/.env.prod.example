# Copy to .env.prod on the VPS (e.g. /opt/mapskayz/.env.prod) and fill in
# real values. Never commit the filled-in file — .gitignore already excludes
# .env.prod. chmod 600 it once it has real secrets in it.

# --- Database ---------------------------------------------------------
# Option A (default): self-hosted Postgres via the "db" service in
# compose.prod.yaml. DATABASE_URL must match POSTGRES_USER/PASSWORD/DB
# below exactly (host "db" is the compose service name, not a real host).
POSTGRES_USER=mapskayz
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=mapskayz
DATABASE_URL=postgresql://mapskayz:replace-with-a-long-random-password@db:5432/mapskayz

# Option B: managed Postgres (DigitalOcean Managed Database, etc). Set
# DATABASE_URL to the connection string it gives you (usually needs
# "?sslmode=require" appended) and don't start the "db" service:
#   podman-compose -f compose.prod.yaml --env-file .env.prod up -d api
# DATABASE_URL=postgresql://user:password@db-host.example.com:25060/mapskayz?sslmode=require

# --- Application --------------------------------------------------------
JWT_SECRET=replace-with-a-long-random-production-secret
# International digits only, e.g. 263781657310.
WHATSAPP_ORDER_NUMBER=
# Comma-separated frontend origin(s) this API accepts requests from.
CORS_ORIGINS=https://mapskayz.com,https://admin.mapskayz.com
# Leave blank until a real payment provider / WhatsApp Business Platform
# webhook is configured against this backend (see backend/.env.example).
PAYMENT_WEBHOOK_SECRET=
WHATSAPP_WEBHOOK_SECRET=

# --- GitLab Container Registry image ------------------------------------
# CI/CD sets these automatically when deploying via the pipeline (see
# .gitlab-ci.yml). Set them here too if you ever run podman-compose by hand.
# CI_REGISTRY_IMAGE=registry.gitlab.com/your-namespace/your-project
# IMAGE_TAG=latest
