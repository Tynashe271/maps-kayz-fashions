# Copy to .env.production (or set as a build-time environment variable in
# Cloudflare Pages / GitHub Pages) before building for deployment.
# The backend's origin — no trailing slash, no /api suffix.
VITE_API_BASE_URL=https://api.yourdomain.com
VITE_STOREFRONT_URL=https://shop.tinashenyenyesa.co.zw

# HTTP Basic Auth gate (frontend-admin/functions/_middleware.js) — these are
# NOT build-time Vite vars, they're read at request time by the Pages
# Function, so they only need to exist in Cloudflare Pages' own Settings >
# Variables and secrets (Production environment), never in a local .env
# file. Listed here for reference only — see DEPLOYMENT.md's "Extra access
# layer" section for the real values' location (BASIC_AUTH_PASS is stored
# as a Secret there, not visible again once saved) and how to rotate them.
# BASIC_AUTH_USER=admin
# BASIC_AUTH_PASS=replace-with-a-long-random-value
